{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "chrome >= 92",
    "edge >= 92",
    "firefox >= 90",
    "safari >= 15.4",
    "ios_saf >= 15.4",
    "samsung >= 16",
    "opera >= 78",
    "not dead"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run llms:gen && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "analyze": "node scripts/analyze.mjs",
    "optimize-images": "node scripts/optimize-images.mjs",
    "openapi:gen": "npx --yes tsx scripts/generate-openapi.ts",
    "indexnow:submit": "npx --yes tsx scripts/indexnow-submit.ts",
    "llms:gen": "npx --yes tsx scripts/generate-llms.ts"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.2",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-navigation-menu": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "next": "14.2.35",
    "posthog-js": "^1.239.1",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.53.2",
    "react-phone-number-input": "^3.4.9",
    "react-syntax-highlighter": "^16.1.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "typecheck": "^0.1.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.10",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.16",
    "postcss": "^8",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
